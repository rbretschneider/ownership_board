# Copy to .env and fill in. Never commit .env.
# Empty optional values turn that feature off cleanly.

# --- Required -----------------------------------------------------------------
# Signs session tokens. 32+ characters from a CSPRNG:
#   openssl rand -hex 32
# Changing it signs everyone out.
AUTH_TOKEN_SECRET=REPLACE

# The board's public origin: https, no trailing slash, no path. Used for
# notification deep links, the SSO redirect URI and the CSRF origin check.
# Leave empty only for local development.
PUBLIC_BASE_URL=https://board.example.com

# --- Server -------------------------------------------------------------------
# 1 when exactly one reverse proxy sits in front (it must connect from a
# private address), 0 for direct access. Controls client IP for sign-in
# throttling and whether X-Forwarded-Proto marks cookies Secure.
#TRUST_PROXY_HOPS=1
#LOG_LEVEL=info
#HOST_PORT=8080
#BIND_ADDRESS=127.0.0.1
#TZ=UTC

# --- Notifications (ntfy) -----------------------------------------------------
# Full topic URL that receives "your move" pushes: questions to answer, PRs to
# review, tickets done. Use a hard-to-guess topic, or protect it with a token.
#BOARD_NTFY_URL=https://ntfy.example.com/my-board
# Full topic URL for operator alerts (error logs, deduplicated per 5 minutes).
#NTFY_URL=https://ntfy.example.com/alerts
# Access token for either topic, if your ntfy server requires one.
#NTFY_TOKEN=

# --- Repo sync ----------------------------------------------------------------
# The easy way: register a GitHub App (docs/agents.md, "Connect GitHub") and put
# its Client ID here. Settings then shows "Connect GitHub". The Client ID is
# public; no client secret or private key is needed.
#GITHUB_APP_CLIENT_ID=
# Optional: only these GitHub logins may be connected (comma-separated).
#GITHUB_ALLOWED_LOGINS=
# Optional: Forgejo/Gitea tokens pasted in Settings may only target these hosts.
#FORGEJO_ALLOWED_HOSTS=
#
# The env-token way (fallback, used when nothing is connected in Settings):
# tokens only need read access to repository metadata. Each provider is off
# while its token is empty. Sync runs at boot and then on the interval.
#GITHUB_TOKEN=
# GitHub Enterprise Server: https://<host>/api/v3
#GITHUB_API_URL=
# Forgejo or Gitea instance root, with an access token (read:repository).
#FORGEJO_URL=https://git.example.com
#FORGEJO_TOKEN=
# Bitbucket Cloud: an Atlassian API token plus its account email (basic
# auth), or leave the email empty to send a repository/workspace access token.
#BITBUCKET_EMAIL=
#BITBUCKET_TOKEN=
# Go duration; 0 turns scheduled sync off (Settings still has "Sync now").
#REPO_SYNC_INTERVAL=1h

# --- SSO (OIDC) ---------------------------------------------------------------
# Empty issuer = no SSO button. Register this exact redirect URI at the IdP:
#   ${PUBLIC_BASE_URL}/api/v1/auth/oidc/callback
# SSO is link-first: sign in with the password once, then link SSO in Settings.
#OIDC_ISSUER_URL=
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_BUTTON_LABEL=Sign in with SSO

# --- Backups ------------------------------------------------------------------
# Daily consistent snapshots in /data/backups; how many to keep, 0 for none.
# Copy that folder off the machine as well.
#BACKUP_KEEP=7
